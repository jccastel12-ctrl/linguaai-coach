# =============================================================================
# LinguaAI Coach — variables para docker-compose (desarrollo local)
# Copia este archivo a .env (`cp .env.example .env`) y reemplaza los valores
# marcados con "change-me". NUNCA subas .env al repositorio.
# =============================================================================

# --- Entorno ---
ENVIRONMENT=development
DEBUG=false

# --- PostgreSQL ---
POSTGRES_USER=linguaai
# Genera una contraseña local: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=linguaai
POSTGRES_PORT=5432

# --- Redis (opcional, perfil "redis") ---
REDIS_PORT=6379
# Descomenta si levantas Redis con `make up-redis`
# REDIS_URL=redis://redis:6379/0

# --- API ---
API_PORT=8000
# Genera un secreto: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-48-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:3000
RUN_MIGRATIONS_ON_START=true

# --- IA para Tutor y Traductor (texto) ---
# rule_based funciona sin servicios externos y sirve para desarrollo.
AI_PROVIDER=rule_based
# Para IA real, usa AI_PROVIDER=openai_compatible y configura un proveedor compatible.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

# --- Web ---
WEB_PORT=3000
# URL de la API vista desde el NAVEGADOR
NEXT_PUBLIC_API_URL=http://localhost:8000

# Payments (v1.0: disabled by default; no real checkout is executed)
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
APP_PUBLIC_URL=http://localhost:3000

# Account email delivery (verification and password reset)
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Proveedor específico del Traductor (v1.5) ---
# Deja vacío para seguir AI_PROVIDER. Para traducción libre con Azure:
# TRANSLATION_PROVIDER=azure_translator
TRANSLATION_PROVIDER=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
