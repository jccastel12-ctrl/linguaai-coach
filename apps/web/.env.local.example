# Variables de la web para ejecución local SIN Docker (`make web-dev`).
# Copia a apps/web/.env.local. Solo las variables NEXT_PUBLIC_* llegan al navegador:
# nunca pongas secretos en ellas.

# URL de la API usada por el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL de la API usada por el servidor de Next (SSR). En Docker: http://api:8000
API_INTERNAL_URL=http://localhost:8000

NEXT_TELEMETRY_DISABLED=1
