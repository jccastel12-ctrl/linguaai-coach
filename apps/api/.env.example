# Variables de la API para ejecución local SIN Docker (`make api-dev`).
# Copia a apps/api/.env y ajusta. Nunca subas el archivo .env.

ENVIRONMENT=development
DEBUG=false

# PostgreSQL local (o el contenedor de docker-compose expuesto en 127.0.0.1:5432)
DATABASE_URL=postgresql+asyncpg://linguaai:change-me-local-db-password@localhost:5432/linguaai

# Opcional
# REDIS_URL=redis://localhost:6379/0

# Obligatorio fuera de development: valor aleatorio de >= 32 caracteres.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-48-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000

# Tutor y Traductor de texto. rule_based no requiere API externa.
AI_PROVIDER=rule_based
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Optional secondary model used after transient failures of AI_MODEL.
AI_FALLBACK_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=0.7

# Payments (v1.0: disabled by default; no real checkout is executed)
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
APP_PUBLIC_URL=http://localhost:3000

# Account email delivery (verification and password reset)
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Proveedor específico del Traductor (v1.5). Si se omite, sigue AI_PROVIDER.
# TRANSLATION_PROVIDER=azure_translator
TRANSLATION_PROVIDER=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
