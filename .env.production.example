# =============================================================================
# LinguaAI Coach — ejemplo de variables para despliegue Docker en producción
# Copia a .env.production y reemplaza TODOS los valores "change-me".
# Nunca subas .env.production al repositorio.
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# Dominios públicos. Deben resolver por DNS al servidor antes de iniciar Caddy.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
APP_PUBLIC_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# PostgreSQL interno del stack. No se publica al host.
POSTGRES_USER=linguaai
POSTGRES_PASSWORD=change-me-strong-database-password
POSTGRES_DB=linguaai
DATABASE_URL=postgresql+asyncpg://linguaai:change-me-strong-database-password@postgres:5432/linguaai

# API / JWT
SECRET_KEY=change-me-generate-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://app.example.com
RUN_MIGRATIONS_ON_START=false

# IA. rule_based permite lanzar sin proveedor externo.
AI_PROVIDER=rule_based
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

# Correo transaccional. "disabled" permite desplegar sin correo;
# para verificación/reset reales usa smtp y completa los campos.
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Pagos permanecen desactivados hasta implementar checkout/webhooks reales.
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Redis es opcional por ahora.
REDIS_URL=
